# 复制为 .env 并填入真实值
# bot token（专属 bot）
KN_CHAT_BOT_TOKEN=你的专属bot_token
# 记录群 chat_id（留空则跳过记录群留痕）
RECORD_GROUP_CHAT_ID=你的记录群chat_id
# Qwen API Key（DashScope 国际版）
QWEN_API_KEY=你的QWEN_API_KEY
QWEN_MODEL=qwen3.7-plus
# 画像数据目录
GOV_DATA_DIR=./data
# 白名单 user_id（逗号分隔多个；留空=应答所有用户）
ALLOWED_USER_IDS=你的user_id
